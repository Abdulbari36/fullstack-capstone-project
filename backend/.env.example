# Copy to .env and adjust
PORT=8000
HOST=0.0.0.0
JWT_SECRET=change-me-in-production
TOKEN_TTL=7d
# Leave unset to use an in-memory MongoDB (great for demos/CI),
# or point at Atlas / local mongod:
# MONGODB_URI=mongodb://127.0.0.1:27017/giftlink
# MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/giftlink
SEED_ON_START=true
